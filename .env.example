# ---------------------------------------------------------------------------
# HELPY web application
# Copy to `.env.local` for development.
# ---------------------------------------------------------------------------

# Backend REST API (must include the /api/v1 prefix)
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api/v1

# Public origin used to build QR links (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side API URL used by Next.js route handlers (BFF) for admin auth.
# Falls back to NEXT_PUBLIC_API_URL when omitted.
API_URL=http://127.0.0.1:4000/api/v1

# Optional: a seeded QR code used to render live service categories on the
# public marketing site. Leave empty to show generic marketing copy.
NEXT_PUBLIC_FEATURED_QR_CODE=DHA6-FRONT-DESK

# Optional: support contact overrides (public settings app.info wins when set)
NEXT_PUBLIC_SUPPORT_EMAIL=hello@helply.pk
NEXT_PUBLIC_SUPPORT_PHONE=+92 300 000 0000
